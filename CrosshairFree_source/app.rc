#include <winresrc.h>

/* app / exe / tray icon (multi-size, generated by make_logo.py) */
1 ICON "CrosshairFree.ico"

/* UI font, loaded privately at startup (nothing is installed on the PC) */
101 RCDATA "ValveRg-Bold.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CrosshairFree - crosshair editor and overlay"
            VALUE "FileVersion",     "2.1.0.0"
            VALUE "InternalName",    "CrosshairFree"
            VALUE "OriginalFilename","CrosshairFree.exe"
            VALUE "ProductName",     "CrosshairFree"
            VALUE "ProductVersion",  "2.1.0.0"
            VALUE "LegalCopyright",  "MIT license"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
